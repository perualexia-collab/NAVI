// NAVI — schéma de données initial (Phase A).
// Reflète le modèle validé dans docs/architecture-proposal.html §06.
// Le référentiel Excel (docs/reference/referentiel-metier-navi.xlsx) reste
// la source de vérité pour le contenu des tables KPIDefinition et Signal —
// ce schéma décrit seulement leur forme.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Utilisateurs & droits — brief §7
// ------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

// PENDING = compte créé par un admin, mot de passe pas encore défini
// (lien d'activation envoyé/à copier) ; ACTIVE = peut se connecter ;
// DISABLED = accès bloqué par un admin. Retours Phase C.5 (2026-09-01).
enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  // Null tant que l'utilisateur n'a pas défini son mot de passe via son
  // lien d'activation (statut PENDING) — pas d'inscription publique, donc
  // pas de mot de passe choisi par l'admin à sa place (brief §7).
  passwordHash String?
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())

  portfolios          Portfolio[]
  scans               Scan[]
  invites             InviteToken[]
  askNaviConversations AskNaviConversation[]
}

// Jeton d'activation à usage unique — on ne stocke jamais le jeton en
// clair, seulement son hash (comme un mot de passe). Le lien complet
// (contenant le jeton brut) n'existe qu'une fois, à la création, et est
// affiché à l'admin pour copie manuelle : aucun fournisseur d'e-mail n'est
// branché pour l'instant (retours Phase C.5, §3).
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------------------------
// Hôtels & portefeuilles — brief §9, §24
// ------------------------------------------------------------------

enum HotelExperienceStatus {
  ACTIVE
  TO_VERIFY
  NOT_FOUND
  ERROR
}

model Hotel {
  id                     String                @id @default(cuid())
  name                   String
  experienceLabel        String // libellé exact recherché dans Expérience
  // Identifiant stable côté Expérience, renseigné une fois la vérification
  // Playwright effectuée (hors scope de cette passe — retours Phase C.5,
  // §2) : évite de re-résoudre la correspondance de nom à chaque scan.
  experienceHotelId      String?
  experienceStatus       HotelExperienceStatus @default(TO_VERIFY)
  disabled               Boolean               @default(false)
  lastConnectionCheckAt  DateTime?
  createdAt              DateTime              @default(now())

  portfolios     PortfolioHotel[]
  scanHotels     ScanHotel[]
  audienceResults    AudienceResult[]
  audienceComparisons AudienceComparison[]
}

model Portfolio {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())

  owner  User             @relation(fields: [ownerId], references: [id])
  hotels PortfolioHotel[]
  scans  Scan[]
}

model PortfolioHotel {
  portfolioId String
  hotelId     String
  addedAt     DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([portfolioId, hotelId])
}

// ------------------------------------------------------------------
// Scans — brief §10, §11, §12, §23
// ------------------------------------------------------------------

enum ScanHotelStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

enum StepStatus {
  PENDING
  RUNNING
  OK
  ERROR
  SKIPPED
}

enum ScanStepName {
  BASE
  CAPTURE
  OTA
  RETURNING
  MARKETING
}

enum ScanErrorType {
  TIMEOUT
  ELEMENT_NOT_FOUND
  PAGE_UNAVAILABLE
  AUTHENTICATION_ERROR
  HOTEL_NOT_FOUND
  NAVIGATION_ERROR
  UNKNOWN_ERROR
}

// Période — stockée en JSON pour rester fidèle à la structure préset/custom
// du brief §18 sans multiplier les colonnes.
model Scan {
  id             String    @id @default(cuid())
  portfolioId    String?
  requestedById  String
  period         Json // { type: "preset", value: "..." } | { type: "custom", startDate, endDate }
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  portfolio   Portfolio?  @relation(fields: [portfolioId], references: [id])
  requestedBy User        @relation(fields: [requestedById], references: [id])
  hotels      ScanHotel[]
}

model ScanHotel {
  id            String          @id @default(cuid())
  scanId        String
  hotelId       String
  status        ScanHotelStatus @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  attempt       Int             @default(1)
  healthScore   Float?
  healthLevel   String?
  // Ventilation du score par pilier — sortie directe de calculateCRMHealth()
  // (backend/src/services/scoring), conforme à l'onglet "Scoring CRM" du
  // référentiel. Null tant que healthScore n'a pas pu être calculé (au
  // moins une donnée requise manquante — cf. backend/scans/run-hotel-scan.ts).
  baseScore        Float?
  captureScore     Float?
  otaScore         Float?
  loyaltyScore     Float?
  activationScore  Float?
  // Activation CRM (résa. CRM / 1 000 profils activables) — métrique
  // dérivée du pilier "Activation CRM" (onglet "CRM Health"), pas une
  // entrée du catalogue KPI (onglet "Cartographie KPIs").
  activationRate   Float?
  rawResult     Json? // payload brut du scan (issu du moteur) — pour audit/debug

  scan          Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  // Phase F6 — suppression réelle d'un hôtel (pas de désactivation) :
  // cascade sur tout son historique de scans.
  hotel         Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  steps         ScanStep[]
  errors        ScanError[]
  kpiResults    KPIResult[]
  signalResults SignalResult[]

  @@index([hotelId])
}

model ScanStep {
  id          String       @id @default(cuid())
  scanHotelId String
  name        ScanStepName
  status      StepStatus   @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?

  scanHotel ScanHotel @relation(fields: [scanHotelId], references: [id], onDelete: Cascade)

  @@unique([scanHotelId, name])
}

model ScanError {
  id               String        @id @default(cuid())
  scanHotelId      String
  stepName         ScanStepName
  errorType        ScanErrorType
  userMessage      String
  technicalMessage String
  occurredAt       DateTime      @default(now())

  scanHotel ScanHotel @relation(fields: [scanHotelId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// KPI — catalogue seedé depuis "Cartographie KPIs" (référentiel Excel)
// ------------------------------------------------------------------

model KPIDefinition {
  id             String   @id // ex: "nonOtaReservationShare"
  label          String
  source         String // ex: "Revenu → OTA"
  dateFilterable Boolean // brief §18 — false pour ota/returning (année N vs N-1 fixe)
  version        String // "V1" | "V2"
  scraped        Boolean  @default(false)

  results KPIResult[]
}

model KPIResult {
  id              String   @id @default(cuid())
  scanHotelId     String
  kpiDefinitionId String
  value           Float?
  available       Boolean  @default(true) // brief §37 — distingue 0 réel de non récupéré
  // Comparaison année N vs N-1 — uniquement pour les KPI non filtrables par
  // période (OTA, Returning Guests) où le moteur scrape déjà les deux
  // années (backend/experience/scrapers/ota.ts, returning-guests.ts).
  // null pour tous les autres KPI (retours réels Phase C, 2026-09-02).
  previousValue   Float?
  evolutionPoints Float?

  scanHotel     ScanHotel     @relation(fields: [scanHotelId], references: [id], onDelete: Cascade)
  kpiDefinition KPIDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@unique([scanHotelId, kpiDefinitionId])
}

// ------------------------------------------------------------------
// Signaux & recommandations — brief §19, §21 — seedés depuis
// "Signals & Playbook" (référentiel Excel)
// ------------------------------------------------------------------

enum SignalSeverity {
  ALERT
  VIGILANCE
  OPPORTUNITY
}

enum AudienceMode {
  NONE
  SINGLE
  MULTIPLE
}

// Phase F2 — suivi d'action sur les recommandations sans audience
// (P01, P05, P08, P12) : DISMISSED est un état à part, pas une étape
// du cycle OPEN → IN_PROGRESS → DONE.
enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  DONE
  DISMISSED
}

model SignalDefinition {
  playbookId           String       @id // P01…P12 — interne, jamais affiché à l'utilisateur
  name                 String
  severity             SignalSeverity
  conditionDescription String
  recommendedAction    String
  audienceMode         AudienceMode @default(NONE)

  results SignalResult[]
}

model SignalResult {
  id          String   @id @default(cuid())
  scanHotelId String
  playbookId  String
  trigger     String // valeur(s) ayant déclenché le signal, pour affichage du "pourquoi"
  detectedAt  DateTime @default(now())

  scanHotel ScanHotel        @relation(fields: [scanHotelId], references: [id], onDelete: Cascade)
  signal    SignalDefinition @relation(fields: [playbookId], references: [playbookId])

  recommendations Recommendation[]
}

model Recommendation {
  id                    String    @id @default(cuid())
  scanHotelId           String
  signalResultId        String
  text                  String
  audienceDefinitionId  String?
  // Phase F1 — trace la création réelle (non temporaire) de la liste dans
  // Expérience, une fois l'audience calculée (E2) ou choisie (E3). null
  // tant que "Créer la liste dans Expérience" n'a pas été utilisé.
  exportedListName      String?
  exportedAt            DateTime?
  // Phase F2 — suivi d'action, affiché uniquement pour les recommandations
  // sans audience (P01, P05, P08, P12) côté frontend ; le champ existe sur
  // toutes les Recommendation (même modèle partagé) mais n'est pas exposé
  // ailleurs.
  status                RecommendationStatus @default(OPEN)

  signalResult        SignalResult        @relation(fields: [signalResultId], references: [id], onDelete: Cascade)
  audienceDefinition  AudienceDefinition? @relation(fields: [audienceDefinitionId], references: [id])
}

// ------------------------------------------------------------------
// Audiences — brief §22, modèle hybride validé le 2026-09-01 :
// calcul direct (option unique) vs comparaison (P10 / P11)
// ------------------------------------------------------------------

model AudienceDefinition {
  id          String @id // ex: "RISK_INACTIVITY", "OTA_CONVERTIBLE"
  name        String
  description String

  results         AudienceResult[]
  recommendations Recommendation[]
}

model AudienceResult {
  id                    String   @id @default(cuid())
  hotelId               String
  audienceDefinitionId  String
  comparisonId          String? // regroupe plusieurs options comparées ensemble (P10/P11)
  recipients            Int
  highlighted           Boolean  @default(false) // marquage ⭐ (ex. règle P10)
  measuredAt            DateTime @default(now())
  // Phase F4 — durée du cycle Audience Builder (créer/mesurer/[supprimer
  // ou conserver]) pour CETTE mesure — base de l'estimation affichée
  // pendant un calcul en cours (même principe que ScanHotel.durationMs).
  durationMs            Int?

  // Phase F6 — suppression réelle d'un hôtel : cascade sur ses mesures
  // d'audience.
  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  audienceDefinition  AudienceDefinition   @relation(fields: [audienceDefinitionId], references: [id])
  comparison          AudienceComparison?  @relation(fields: [comparisonId], references: [id])
}

model AudienceComparison {
  id             String  @id @default(cuid())
  hotelId        String
  playbookId     String // P10 ou P11 à l'origine de la comparaison
  chosenResultId String?

  // Phase F6 — suppression réelle d'un hôtel : cascade sur ses comparaisons.
  hotel   Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  results AudienceResult[]
}

// ------------------------------------------------------------------
// Ask NAVI — Phase H6 : sauvegarde de l'historique de conversation,
// demandée explicitement (jusque-là purement en mémoire côté frontend,
// perdu à chaque rechargement de page).
// ------------------------------------------------------------------

model AskNaviConversation {
  id        String   @id @default(cuid())
  userId    String
  // Titre affiché dans l'historique — la première question posée dans ce fil.
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AskNaviMessage[]

  @@index([userId])
}

model AskNaviMessage {
  id             String   @id @default(cuid())
  conversationId String
  question       String
  answer         String
  // Sources affichées par le frontend ("Sources utilisées") — même forme
  // que AskNaviSource ({ label, detail }[]), stockée telle quelle.
  sources        Json
  createdAt      DateTime @default(now())

  // Seuls les échanges réussis sont persistés (retour réel 2026-09-03) —
  // un échec est retentable, ce n'est pas un historique à conserver.
  conversation AskNaviConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
