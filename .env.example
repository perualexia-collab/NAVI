# Copier en .env et renseigner les vraies valeurs. Ne JAMAIS committer .env.

# --- Backend / API ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# --- Base de données ---
DATABASE_URL=postgresql://navi:navi@localhost:5432/navi

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Auth NAVI ---
# Secret de signature des sessions — générer une valeur aléatoire longue (ex: openssl rand -hex 32)
SESSION_SECRET=change-me

# --- Expérience (CRM D-EDGE) ---
# Identifiants du compte de service utilisé par les workers Playwright.
# Jamais hardcodés dans le code — lus uniquement depuis l'environnement.
# Optionnels : pré-remplissent email/mot de passe à la connexion (voir
# backend/experience/core/session.ts) — la 2FA reste TOUJOURS manuelle,
# quelles que soient ces valeurs. Sans elles, tout reste manuel comme avant.
EXPERIENCE_BASE_URL=https://crm.experience-hotel.com/
EXPERIENCE_SERVICE_ACCOUNT_EMAIL=
EXPERIENCE_SERVICE_ACCOUNT_PASSWORD=

# --- Scan / Playwright ---
# Concurrence de départ du premier vertical slice — ne pas augmenter sans validation
# de la tolérance réelle d'Expérience (cf. NAVI Architecture Proposal §11.2).
SCAN_QUEUE_CONCURRENCY=1
PLAYWRIGHT_HEADLESS=true
# Profil navigateur persistant (session + 2FA résolue manuellement une fois,
# cf. Architecture Proposal §07/§11.4). Jamais committé (.gitignore).
EXPERIENCE_PROFILE_DIR=./experience-profile

# --- Ask NAVI / LLM Service ---
# Optionnel : sans ces valeurs, NAVI démarre et fonctionne normalement,
# Ask NAVI n'est simplement pas branché à un LLM. Provider-agnostic par
# construction (§09 Architecture Proposal) — LLM_PROVIDER ne vaut
# aujourd'hui que "http-openai-compatible" (n'importe quel endpoint
# compatible OpenAI : Groq, un futur self-host...), jamais "groq" en dur
# dans le code. Config actuelle : Groq (plan gratuit) + Qwen.
LLM_PROVIDER=http-openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
# Modèle Qwen actif sur le plan gratuit Groq au 2026-09-03 — à revérifier
# sur https://console.groq.com/docs/models si Groq le fait évoluer
# (qwen/qwen3-32b, précédemment utilisé, déprécié depuis le 2026-06-17).
LLM_MODEL=qwen/qwen3.6-27b
# Clé API Groq — https://console.groq.com/keys. Jamais committée
# (backend/.env est dans .gitignore), jamais exposée au frontend, jamais
# loguée.
GROQ_API_KEY=
